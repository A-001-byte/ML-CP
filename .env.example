# ── ThreatSense-AI Environment Configuration ─────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_VALUE

# ── Admin credentials (set before first run to override auto-generated) ───────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deployment
OPERATOR_PASSWORD=change-me-operator
VIEWER_PASSWORD=change-me-viewer

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_DEVICE=cuda:0         # cuda:0 | cpu | auto
PIPELINE_PERSON_SKIP=1         # detect persons every N frames (1=every frame)
FLASK_DEBUG=0                  # 1 for debug mode (never in production)

# ── Email Alerts (optional — leave blank to disable) ─────────────────────────
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-email@gmail.com
ALERT_SMTP_PASS=your-app-password
ALERT_EMAIL_TO=security-team@yourorg.com

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws
